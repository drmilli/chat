# Copy to .env and fill in.
# NEVER put real credentials in this file — .env is gitignored, this one is NOT.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Realtime transport. Left blank the adapter no-ops, which means a message does
# NOT appear for other people in the room until they reload the page.
REALTIME_URL=
REALTIME_KEY=

PORT=3000

# The single browser origin allowed to call this API.
# Defaults to "*" — set it to your web app's origin before going live.
CORS_ORIGIN=https://token-chat.vercel.app

# Set to 1 (or a hop count) ONLY when running behind a reverse proxy or CDN, so
# the rate limiter reads the real client IP from X-Forwarded-For. Leaving it
# unset behind a proxy makes every visitor share one rate-limit bucket; setting
# it when NOT behind a proxy lets clients spoof their IP.
TRUST_PROXY=1

# Postgres tuning. Neon scales compute to zero when idle; waking it can take
# well over 10s, so the connect timeout must be generous.
PG_CONNECT_TIMEOUT_MS=30000
PG_IDLE_TIMEOUT_MS=20000
PG_POOL_MAX=10
PG_QUERY_RETRIES=2

# Requests per window, per IP and per identity.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_IDENTITY_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000

# --- Sessions & moderation (required in production) ---
# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to boot in production without it; changing it logs everyone out.
SESSION_SECRET=
SESSION_TTL_MS=2592000000

# Comma-separated wallet addresses allowed to use /api/admin and /api/bans.
# Fails CLOSED: with this empty, nobody can moderate.
ADMIN_WALLETS=B6abMcSZFiWu6TeJSwP6NrjqzSnQf7ucQH139vfQ6oSs

# Shown in the sign-in message the user signs.
SIGN_IN_DOMAIN=token-chat.vercel.app

# ─── Trading execution (T-402, services/execution) ────────────────────────────
# Nothing below is needed for chat. The execution engine refuses to start
# without a router key, so leaving these blank simply keeps trading off.

# Which chain to execute on. "robinhood" is mainnet (chain id 4663, D-001).
TRADE_CHAIN=robinhood

# RPC endpoints in failover order, comma separated. Overrides the defaults
# entirely, so ops can repoint without a deploy. D-005 item 3 requires at
# least two — one provider is a single point of failure for every trade.
ROBINHOOD_RPC_URLS=
# Or supply keys and let chains.js order them (Alchemy first, then first-party).
ALCHEMY_API_KEY=alch_RRZD1QzLNUyi9OL8Bk7De
QUICKNODE_RPC_URL=

# Testnet, for the T-305 acceptance criterion. The testnet chain id is NOT
# hardcoded because it was never confirmed — look it up before using it.
ROBINHOOD_TESTNET_CHAIN_ID=
ROBINHOOD_TESTNET_RPC_URLS=

# Aggregators (D-005 item 1). 1inch is primary, 0x the fallback. With only one
# configured you still trade, but an aggregator outage stops trading.
ONEINCH_API_KEY=
ZEROEX_API_KEY=

# Slippage guards. On this chain there is no MEV relay to hide behind
# (D-005 item 2), so these ARE the user protection.
TRADE_SLIPPAGE_BPS=100          # default tolerance, 100 = 1%
TRADE_MAX_SLIPPAGE_BPS=500      # hard cap; above this a tolerance is a blank cheque
TRADE_MAX_QUOTE_AGE_MS=15000    # 100ms blocks age a quote fast
TRADE_MAX_PRICE_IMPACT_BPS=1000 # refuse a route that moves the price >10%

# Gas. Do NOT add a priority-fee escalator: ordering is first-come-first-served,
# so a higher tip buys no better position (D-005 item 4).
GAS_LIMIT_BUFFER_PERCENT=25
PRIORITY_FEE_WEI=0
MAX_GAS_COST_WEI=10000000000000000   # 0.01 ETH — refuse a trade costing more to submit

# Confirmation tracking.
CONFIRM_POLL_INTERVAL_MS=250
CONFIRM_TIMEOUT_MS=60000
BROADCAST_ATTEMPTS=3
NONCE_RESYNC_AFTER_MS=60000

# ─── Live voice chat (WebRTC) ─────────────────────────────────────────────────
# Signalling runs over the existing SSE hub, so voice inherits its RUN ONE
# INSTANCE constraint — and more severely: two peers on different instances
# never exchange an offer and simply never hear each other.

# Mesh size. This counts EVERY participant, not just the ones talking: each
# browser holds a connection to every other and uploads its mic N-1 times.
# Raising this past ~6 degrades audio for everyone. Many listeners needs an SFU.
VOICE_MAX_PARTICIPANTS=6
VOICE_STALE_AFTER_MS=45000
VOICE_MAX_SIGNAL_BYTES=16384

# TURN relay. NOT OPTIONAL IN PRODUCTION: roughly 10-20% of users sit behind
# symmetric NAT and cannot connect peer-to-peer at all. With this unset they get
# no audio, and it looks like the feature is broken rather than unconfigured.
# Credentials are issued per session as coturn REST-API HMACs, so the secret
# itself never reaches the browser.
TURN_URLS=
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Overrides the public STUN defaults if you'd rather not depend on Google's.
STUN_URLS=

# How long a kick keeps someone out of a room's voice chat. Keyed by identity,
# so reconnecting with a fresh peer id does not undo it.
VOICE_BLOCK_TTL_MS=900000
