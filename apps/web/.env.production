# Production build target for the API.
# Dev leaves this unset so requests stay relative and Vite's /api proxy handles
# them; a production bundle has no proxy, so it needs the absolute origin.
VITE_API_URL=https://chat-ol91.onrender.com

# WalletConnect (T-206) — the only way a phone wallet can connect, since there
# is no extension on mobile to inject a provider.
#
# Free project id from https://cloud.reown.com (formerly WalletConnect Cloud).
# Leave it blank and the mobile option is hidden entirely: the ~1 MB
# WalletConnect bundle is then tree-shaken out and costs nothing. Set it and the
# bundle still only loads when a user actually picks the mobile option.
#
# This is a PUBLIC identifier — it ships in the client bundle by design and is
# not a secret. Restrict it by allowed domain in the Reown dashboard.
VITE_WALLETCONNECT_PROJECT_ID=
