{
  "manifest_version": 3,
  "name": "Token Chat Extension",
  "version": "0.1.0",
  "description": "Adds a chat room to every token page you visit on GMGN, Axiom and Padre \u2014 one shared room per contract address, with voice notes and wallet-verified identity.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gmgn.ai/*",
    "https://*.gmgn.ai/*",
    "https://axiom.trade/*",
    "https://*.axiom.trade/*",
    "https://padre.gg/*",
    "https://*.padre.gg/*",
    "https://chat-ol91.onrender.com/*",
    "https://token-chat.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:4173/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Token Chat",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*",
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://padre.gg/*",
        "https://*.padre.gg/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
